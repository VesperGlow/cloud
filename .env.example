APP_ADDR=:8080
APP_DATA_DIR=/data
APP_BASE_URL=http://localhost:8080
COOKIE_SECURE=false

ADMIN_USERNAME=admin
# 可选；留空时首次启动会生成一次性随机密码并打印到 cloud 容器日志。
ADMIN_PASSWORD=

S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=cloud
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me-minio
S3_PATH_STYLE=true

PRESIGN_EXPIRES=15m
BLOCK_SIZE=4194304
# FastCDC 可变分块边界；不设置时分别为 BLOCK_SIZE / 4 与 BLOCK_SIZE * 4。
FASTCDC_MIN_SIZE=1048576
FASTCDC_MAX_SIZE=16777216
UPLOAD_EXPIRES=24h
GC_INTERVAL=1h
# 可选：视频缩略图抽帧使用的 ffmpeg 可执行文件路径（默认 PATH 中的 ffmpeg）
# FFMPEG_PATH=ffmpeg
