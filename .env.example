APP_ADDR=:8080
APP_DATA_DIR=/data
APP_BASE_URL=http://localhost:8080
COOKIE_SECURE=false

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now

S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
